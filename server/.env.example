# ==============================================================================
# GoalCalendar Server - Environment Variables Configuration
# ==============================================================================

# Server Core Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/goalcalendar

# Authentication & JWT Security Tokens
# Lưu ý: Trong môi trường production, hãy sử dụng chuỗi bí mật ngẫu nhiên dài ít nhất 32 ký tự
JWT_ACCESS_SECRET=super_secret_access_jwt_key_goalcalendar_2026_must_be_long
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_goalcalendar_2026_must_be_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# Module LEARN: Google Gemini AI Configuration & Multimodal Chatbot
# ==============================================================================
# Hướng dẫn lấy API Key miễn phí từ Google AI Studio:
# 1. Truy cập https://aistudio.google.com và đăng nhập bằng tài khoản Google.
# 2. Nhấp "Get API key" -> "Create API key in new project" và copy mã key.
# 3. Dán key vào biến GEMINI_API_KEY dưới đây.
# (Nếu để trống, hệ thống sẽ tự động kích hoạt Intelligent Mock Assistant để trải nghiệm offline/testing).
GEMINI_API_KEY=

# Gemini Model Name
# Các model được hỗ trợ tốt nhất:
# - gemini-1.5-flash (Nhanh, phản hồi tức thì, tối ưu chi phí và hạn ngạch free)
# - gemini-2.0-flash-exp (Model thế hệ mới, đa phương thức mạnh mẽ)
# - gemini-1.5-pro (Mô hình suy luận sâu, phù hợp các bài luận phức tạp)
GEMINI_MODEL=gemini-1.5-flash

# Giới hạn số lượt chat AI và Token hàng ngày cho mỗi người dùng (Rate Quota Control)
MAX_DAILY_CHAT_REQUESTS=50
MAX_DAILY_INPUT_TOKENS=100000
MAX_DAILY_OUTPUT_TOKENS=50000

# ==============================================================================
# Module LEARN: Cấu hình tải tệp & tài liệu đính kèm (File & Image Uploads)
# ==============================================================================
# Kích thước tệp tải lên tối đa (tính theo Megabytes, mặc định: 10MB)
MAX_UPLOAD_FILE_SIZE_MB=10

# Danh sách MIME types được phép tải lên (cách nhau bởi dấu phẩy)
# Hỗ trợ: Ảnh JPG, PNG, WEBP và tài liệu PDF, TXT, Markdown, Word DOCX
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document
